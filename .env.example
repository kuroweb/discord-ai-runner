DISCORD_TOKEN=your_bot_token_here
AI_ADAPTER=claude  # claude (default) | codex | cursor-agent
ANTHROPIC_MODELS_API_KEY=your_anthropic_api_key_here  # /models 用（ANTHROPIC_API_KEY は SDK が使用）
OPENAI_MODELS_API_KEY=your_openai_api_key_here  # /models 用（AI_ADAPTER=codex 時）
CURSOR_API_KEY=your_cursor_api_key  # /models 用（AI_ADAPTER=cursor-agent 時）
AGENT_CLI_CREDENTIAL_STORE=file  # cursor-agentでkeychain参照するのを無効化
BATCH_ENABLED=false  # true で batch ジョブを有効化
